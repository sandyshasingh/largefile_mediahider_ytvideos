<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LargeFilePermissionActivity">

    <ImageView

        android:id="@+id/permission_bigimage"
        android:layout_width="220dp"
        android:scaleType="fitXY"
        android:padding="32dp"
        android:layout_marginTop="30dp"

        android:src="@drawable/largefile_img"

        android:layout_height="220dp"


        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="12dp"

        app:layout_constraintBottom_toTopOf="@id/first_line"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/allow_tag"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/txt1"
        android:layout_marginTop="52dp"

        app:layout_constraintLeft_toLeftOf="parent"
        android:padding="12dp"
        android:gravity="center"
        app:layout_constraintRight_toRightOf="parent"
        android:text="Allow Permission"
        android:textSize="16sp"
        android:background="@drawable/allow_btn_bkgnd"
        android:textColor="@color/white"
        android:textStyle="bold"
        />



    <TextView
        android:id="@+id/txt1"
        app:layout_constraintTop_toBottomOf="@+id/first_line"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="88dp"
        android:textSize="14sp"
        android:gravity="center"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"

        android:textColor="@color/black"
        android:text="Please grant permission to access\nmedia files on your device"/>



    <TextView
        android:id="@+id/first_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Storage Permission"
        android:textSize="25sp"
        android:textStyle="bold"

        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/permission_bigimage"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"

        android:layout_marginBottom="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>