<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent">

    <LinearLayout

        android:background="#E5E7EB"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".LargeFileMainActivity">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/backk_icon"
                android:padding="4dp"

                android:src="@drawable/back_icon"
                android:layout_width="36dp"
                android:layout_gravity="center"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/text_sortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"

                android:layout_marginStart="12dp"

                android:text="Cleaner"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
        <ImageView
            android:layout_width="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:src="@drawable/largefile_img"
            android:layout_height="150dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Storage Found"
            android:layout_gravity="center_horizontal"
            />

        <TextView
            android:id="@+id/consumed_space"
            android:layout_width="wrap_content"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_gravity="center_horizontal"
            />

        <TextView
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textSize="20sp"
            android:text="Large Files Finder"
            android:textColor="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:text="Easily clean up big files and free space."
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/large_videos"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:background="@color/white"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                android:layout_margin="8dp"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:padding="12dp"
                    android:layout_height="wrap_content">



                    <ImageView
                        android:id="@+id/large_video_img"
                        android:src="@drawable/large_video_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                    <TextView

                        android:layout_toEndOf="@+id/large_video_img"
                        android:layout_width="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Videos"
                        android:layout_marginStart="12dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_below="@+id/large_video_img"
                        android:id="@+id/large_video_size"
                        android:layout_width="wrap_content"
                        android:textColor="@color/red"
                        android:singleLine="true"
                        android:textSize="20sp"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_below="@id/large_video_size"
                        android:id="@+id/count_large_videos"
                        android:layout_width="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:text="0 videos over 25.0 MB"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/large_photo"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:background="@color/white"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                android:layout_margin="8dp"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:padding="12dp"
                    android:layout_height="wrap_content">



                    <ImageView
                        android:id="@+id/large_photos_img"
                        android:src="@drawable/large_photo_icon"

                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                    <TextView
                        android:layout_toEndOf="@+id/large_photos_img"
                        android:layout_width="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Photos"
                        android:layout_marginStart="12dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_below="@+id/large_photos_img"
                        android:id="@+id/large_photos_size"
                        android:layout_width="wrap_content"
                        android:textColor="@color/red"
                        android:singleLine="true"
                        android:textSize="20sp"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_below="@id/large_photos_size"
                        android:id="@+id/count_large_photos"
                        android:layout_width="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:text="0 photos over 5.0 MB"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>

        <TextView
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:text="Duplicate Finder"
            android:textColor="@color/black"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:text="Delete identical files with one tap to free up storage."
            />

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:id="@+id/duplicate_image"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#F0F1F6"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/fd_img_icon"
                        android:id="@+id/photos_icon"/>
                    <TextView
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="4dp"
                        android:layout_below="@id/photos_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Photos"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/duplicate_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#F7F3F0"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/fd_video_icon"
                        android:layout_height="40dp"
                        android:id="@+id/videos_icon"/>
                    <TextView
                        android:layout_below="@id/videos_icon"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Videos"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/duplicate_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#F4F0F1"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/fd_audio_icon"
                        android:id="@+id/songs_icon"/>
                    <TextView
                        android:layout_below="@id/songs_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"
                        android:text="Songs"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>



    </LinearLayout>

    <FrameLayout
        android:id="@+id/home_fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />



</FrameLayout>
