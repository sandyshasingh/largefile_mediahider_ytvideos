<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".LargeFilesFragment">

    <RelativeLayout
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back_main"
                android:layout_width="36dp"
                android:padding="4dp"
                android:src="@drawable/back_icon"
                android:layout_height="36dp"

                />
        <TextView
            android:id="@+id/text_sortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/back_main"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"

            android:text="Large Files"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:layout_marginStart="10dp"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:id="@+id/all_selected"
            android:button="@drawable/checkbox_selector"
            android:layout_width="18dp"
            android:layout_height="18dp"/>

        <ImageView
            android:id="@+id/change_layout"
            android:layout_width="30dp"
            android:layout_toStartOf="@+id/all_selected"
            android:layout_height="30dp"
            android:layout_centerVertical="true"



            android:padding="5dp"
            app:srcCompat="@drawable/grid_icon" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/filter"
        android:layout_below="@id/main_toolbar"
        android:layout_width="wrap_content"
        android:background="@drawable/txt_bkgnd"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="14dp"
            android:layout_gravity="center_vertical"

            android:src="@drawable/filter_icon"
            android:layout_height="14dp"/>

        <TextView
            android:id="@+id/filter_heading"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:textColor="#2563EB"
            android:layout_height="wrap_content"
            android:text="Larger thann 25 MB"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_list_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filter"
        android:clipToPadding="false"
        android:paddingBottom="165dp"
        android:layout_above="@+id/clean_files"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/clean_files"
        android:padding="14dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white">
        <RelativeLayout
            android:id="@+id/clean_large_files"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:background="@drawable/btm_clean_bkgnd"

            android:padding="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_centerInParent="true"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="22dp"
                    android:src="@drawable/clean_brush_icon"
                    android:layout_height="22dp"/>

                <TextView
                    android:id="@+id/clean_file_size"
                    android:layout_marginStart="12dp"
                    android:textSize="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="Clean Up 0 MB"/>

            </LinearLayout>



        </RelativeLayout>
    </LinearLayout>



</RelativeLayout>