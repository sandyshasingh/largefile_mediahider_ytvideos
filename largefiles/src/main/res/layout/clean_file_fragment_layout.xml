<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:layout_height="wrap_content"
    tools:context="CleanFilesFragment">
        <LinearLayout
            android:id="@+id/main_layout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:gravity="center"
            >

            <FrameLayout
                android:id="@+id/done_fragment"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="horizontal">
<!--                <com.airbnb.lottie.LottieAnimationView-->
<!--                    android:layout_marginTop="@dimen/size_40dp"-->
<!--                    android:id="@+id/cleanmaster_animation"-->
<!--                    android:layout_width="200dp"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:layout_height="200dp"-->
<!--                    android:visibility="visible"-->
<!--                    app:lottie_autoPlay="true"-->
<!--                    app:lottie_loop="true"-->
<!--                    app:lottie_rawRes="@raw/done_cm" />-->

                <LinearLayout
                    android:id="@+id/final_backk"
                    android:layout_width="match_parent"

                    android:layout_height="wrap_content">

                    <ImageView

                        android:padding="4dp"

                        android:src="@drawable/back_icon"
                        app:tint="@color/black"
                        android:layout_width="36dp"
                        android:layout_gravity="center"
                        android:layout_height="36dp" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:text="Clean Up"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/size_cleaned"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/savedspace_txt"

                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="Your device is now optimized"/>










        </LinearLayout>

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="18sp"
                android:text="Duplicate Finder"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:text="Delete identical files with one tap to free up storage."
                />

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#F0F1F6"
                    android:layout_weight="1">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/fd_img_icon"
                            android:id="@+id/photos_icon"/>
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="4dp"
                            android:layout_below="@id/photos_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:textColor="@color/black"
                            android:text="Photos"/>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#F7F3F0"
                    android:layout_weight="1">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="40dp"
                            android:src="@drawable/fd_video_icon"
                            android:layout_height="40dp"
                            android:id="@+id/videos_icon"/>
                        <TextView
                            android:layout_below="@id/videos_icon"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_centerHorizontal="true"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Videos"/>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#F4F0F1"
                    android:layout_weight="1">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/fd_audio_icon"
                            android:id="@+id/songs_icon"/>
                        <TextView
                            android:layout_below="@id/songs_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:layout_marginTop="4dp"
                            android:layout_centerHorizontal="true"
                            android:text="Songs"/>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>


            </LinearLayout>


            <RelativeLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_gravity="center_horizontal">

                <androidx.cardview.widget.CardView


                    android:layout_width="match_parent"
                    android:id="@+id/back_home"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#EDEDED"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:padding="12dp"
                        android:layout_gravity="center"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/img_cm2"
                            android:layout_centerVertical="true"
                            android:src="@drawable/home_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"/>

                        <TextView
                            android:layout_marginStart="14dp"
                            android:id="@+id/txt_cm3"
                            android:text="Back to Home"

                            android:textSize="16sp"
                            android:layout_centerVertical="true"
                            android:textStyle="bold"
                            android:textColor="@color/black"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_cm2"/>



                    </RelativeLayout>


                </androidx.cardview.widget.CardView>

            </RelativeLayout>

        </LinearLayout>



</RelativeLayout>
