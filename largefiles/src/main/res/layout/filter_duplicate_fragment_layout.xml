<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="FilterDuplicateFragment"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/zrp_file_filter_duplicate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:visibility="gone">

        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/zrp_largefile"
            />
        <LinearLayout
            android:layout_marginTop="190dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textSize="24sp"
                android:text="No duplicate Files Found"/>
           <!-- <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/textColorSortcut"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/files_not_found"/>-->

        </LinearLayout>
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/rl_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/backk"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"


            app:cardCornerRadius="8dp"

            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/backk_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:padding="4dp"
                android:src="@drawable/back_icon" />


        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/fragment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/backk"
            android:textStyle="bold"


            android:textColor="@color/black"
            android:textSize="18sp" />

    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView

        android:id="@+id/duplicate_items_list"
        android:layout_below="@+id/rl_toolbar"
        android:layout_width="match_parent"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_height="match_parent"/>
</RelativeLayout>