<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FF4242"
    android:clickable="true"

    android:focusable="true"
    tools:context=".CleanFragment"
    android:orientation="vertical">
    <RelativeLayout

        android:id="@+id/loading_screen"
        android:elevation="2dp"
        android:clickable="true"

        android:focusable="true"

        android:layout_width="match_parent"
        android:layout_height="130dp">
        <LinearLayout
            android:id="@+id/backk_load"
            android:layout_width="match_parent"

            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/backk"
                android:padding="4dp"
                android:src="@drawable/clean_master_back"
                android:layout_width="36dp"
                android:layout_gravity="center"
                android:layout_height="36dp" />
            <TextView
                android:id="@+id/text_sortcut_load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/backk"
                android:text="Cleaner"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loader_junkfiles"
            android:layout_width="240dp"

            android:layout_centerHorizontal="true"
            android:layout_marginTop="90dp"
            android:layout_height="240dp"
            android:visibility="gone"
            app:lottie_loop="true"

            app:lottie_autoPlay="true"
             />

        <TextView
            android:id="@+id/heading_loader"
            android:layout_marginTop="100dp"
            android:layout_below="@+id/loader_junkfiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking for junk files..."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>

      <TextView
          android:id="@+id/total_size"


          android:textSize="38sp"
          android:gravity="center"
          android:layout_marginTop="36dp"
          android:layout_gravity="center_horizontal"

          android:textAlignment="center"
          android:textColor="@color/white"

          android:layout_marginBottom="80dp"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          />







    <RelativeLayout
        android:background="@drawable/clean_master_home_bkgnd"

        android:layout_width="match_parent"




        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/parent_recycler_view_clean_master"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="90dp"
            android:paddingTop="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical">

        </androidx.recyclerview.widget.RecyclerView>

        <LinearLayout


           android:layout_alignParentBottom="true"
            android:id="@+id/delete_junk"
            android:layout_width="match_parent"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"

            android:background="@drawable/rouded_button_cleanmaster"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:orientation="vertical" >
            <TextView
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:id="@+id/btm_btn"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:textSize="22sp"


                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/cancel_clean"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:visibility="gone"
                android:id="@+id/mloader"
                android:layout_gravity="center"
                android:layout_width="25dp"
                android:layout_height="25dp"/>

        </LinearLayout>

    </RelativeLayout>



</LinearLayout>