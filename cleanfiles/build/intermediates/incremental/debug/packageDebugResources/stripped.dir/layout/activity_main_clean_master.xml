<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:id="@+id/main"
    android:background="@color/white"
    tools:context=".CleanFilesActivity"
    android:orientation="vertical">

        <FrameLayout
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="370dp"



                    android:orientation="horizontal">


                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="340dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="340dp">




                            <RelativeLayout
                               android:layout_marginTop="100dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/heading_one"
                                    android:layout_width="wrap_content"
                                    android:text="Optimize your \ndevice now"
                                    android:textSize="32dp"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:layout_below="@+id/heading_one"
                                    android:layout_width="wrap_content"
                                    android:text="There's a lot of trash"
                                    android:textSize="16dp"
                                    android:layout_marginTop="12dp"
                                    android:textColor="@color/material_gray_500"
                                    android:layout_height="wrap_content"/>

                                <com.github.lzyzsd.circleprogress.DonutProgress
                                    android:id="@+id/arc_progress2"
                                    android:layout_width="100dp"
                                    android:layout_height="100dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentTop="true"
                                    app:donut_finished_color="#FF4242"
                                    app:donut_finished_stroke_width="8dp"
                                    app:donut_unfinished_stroke_width="8dp"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:donut_text_color="@color/black"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_marginStart="50dp"
                                    app:arc_finished_color="#FF4242"
                                    custom:arc_progress="0"
                                    app:arc_text_size="22dp"
                                    app:arc_suffix_text_size="0dp"
                                    app:arc_unfinished_color="@color/material_gray_600" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="72dp"
                                    android:visibility="gone"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/used_space"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"


                                        android:text=""
                                        android:textColor="@color/black"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:text="Used Space"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_alignParentEnd="true"

                                    android:visibility="gone"
                                    android:layout_marginEnd="72dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                <TextView
                                    android:textSize="20sp"
                                    android:layout_gravity="center_horizontal"
                                    android:id="@+id/freeSpace"
                                    android:textColor="@color/black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Free space"/>
                                </LinearLayout>
                            </RelativeLayout>

                        </FrameLayout>

                        <RelativeLayout
                            android:id="@+id/backk"
                            android:layout_width="match_parent"

                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/backk_icon"
                                    android:padding="4dp"
                                    android:src="@drawable/clean_master_back"
                                    android:layout_width="36dp"
                                    app:tint="@color/black"

                                    android:layout_gravity="center"
                                    android:layout_height="36dp" />

                            <TextView
                                android:id="@+id/text_sortcut"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@+id/backk_icon"
                                android:text="@string/clean_up"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </RelativeLayout>
                    </FrameLayout>

                </FrameLayout>

                <RelativeLayout
                    android:id="@+id/filter_duplicate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_gravity="center_horizontal">

                    <androidx.cardview.widget.CardView


                        android:layout_width="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#EDEDED"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:padding="12dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/img_cm2"
                                android:layout_centerVertical="true"
                                android:src="@drawable/filter_duplicate_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"/>

                            <TextView
                                android:layout_marginStart="14dp"
                                android:id="@+id/txt_cm3"
                                android:text="Filter Duplicate"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@+id/img_cm2"/>

                            <TextView
                                android:id="@+id/txt_cm4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txt_cm3"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="22dp"
                                android:layout_toEndOf="@+id/img_cm2"
                                android:text="Helps to clean and manage duplicate\nfiles"
                                android:textSize="10sp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/right_arrow_cm" />
                        </RelativeLayout>


                    </androidx.cardview.widget.CardView>

                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                   >
                <TextView
                    android:id="@+id/clean_up"
                    android:singleLine="true"
                    android:layout_width="160dp"
                    android:layout_marginBottom="36dp"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:background="@drawable/rouded_button_cleanmaster"

                    android:layout_gravity="bottom|center"
                    android:gravity="center"

                    android:text="Clean Now"
                    android:layout_height="48dp"/>
                </LinearLayout>



            </LinearLayout>

            <FrameLayout
                android:id="@+id/clean_fragment_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />
        </FrameLayout>

</LinearLayout>