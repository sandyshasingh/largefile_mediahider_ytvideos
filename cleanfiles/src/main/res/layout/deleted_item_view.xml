<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:paddingBottom="4dp"
    android:paddingTop="4dp"
    android:background="?attr/selectableItemBackground"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon_app_deleted"
        android:layout_width="20dp"
        android:src="@drawable/ic_icon_deleted_item"
        android:layout_height="20dp"/>
    <TextView
        android:id="@+id/path_deleteditem"
        android:layout_toEndOf="@+id/icon_app_deleted"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:textSize="10sp"

        android:textColor="@color/white"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:layout_width="100dp"
        android:layout_marginEnd="8dp"

        android:layout_height="wrap_content"/>
    <LinearLayout
        android:id="@+id/temp"
        android:layout_marginStart="8dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/path_deleteditem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        >
        <TextView
            android:id="@+id/size_deleteditem"
            android:textSize="10sp"
            android:textColor="#bdbdbd"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>


</RelativeLayout>