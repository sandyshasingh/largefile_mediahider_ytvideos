<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginBottom="30dp"
    android:layout_marginStart="20dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:padding="8dp"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="20dp"
        android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/category_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
    <TextView
        android:id="@+id/title_cleanmaster"
        android:layout_width="wrap_content"
        android:layout_toEndOf="@+id/category_icon"
        android:layout_marginStart="12dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content"/>



            <ProgressBar
                android:id="@+id/loader"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"/>


            <ImageView
                android:layout_marginStart="10dp"
                android:layout_marginEnd="18dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:id="@+id/is_selected_cleanmaster"
                android:layout_width="18dp"
                android:layout_height="18dp"/>

        <!--<LinearLayout
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content">-->
            <TextView
                android:layout_toStartOf="@+id/is_selected_cleanmaster"

                android:layout_marginTop="4dp"
                android:id="@+id/size_cleanmaster"
                android:layout_width="wrap_content"
                android:textSize="12sp"
                android:layout_centerVertical="true"

                android:textColor="#262626"
                android:visibility="gone"

                android:textStyle="bold"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/view_cm"
                android:layout_toEndOf="@+id/size_cleanmaster"
                android:layout_below="@+id/title_cleanmaster"

                android:visibility="gone"

                android:layout_marginTop="6dp"
                android:background="#262626"
                android:layout_marginStart="8dp"
                android:layout_width="1dp"
                android:layout_height="12dp"/>

        <TextView
            android:id="@+id/count_items"
            android:layout_width="90dp"
            android:layout_height="wrap_content"


            android:visibility="gone"
            android:layout_below="@+id/title_cleanmaster"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@+id/view_cm"
            android:textColor="#262626"
            android:textSize="12sp" />

            <ImageView

                android:id="@+id/expand"
                android:layout_marginEnd="34dp"
                android:layout_toEndOf="@+id/title_cleanmaster"
                android:padding="8dp"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_expand" />

            <ImageView

                android:id="@+id/collapse"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="34dp"
                android:layout_toEndOf="@+id/title_cleanmaster"
                android:padding="8dp"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_collapse"
                android:visibility="gone" />

      <!--  </LinearLayout>-->

  <!--  </LinearLayout>-->

    </RelativeLayout>

    <LinearLayout
        android:layout_marginStart="8dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="16dp"
        android:id="@+id/child_recycler_view_clean_master"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>