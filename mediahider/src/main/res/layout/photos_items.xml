<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clipToPadding="false"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:padding="1dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <com.example.mediahider.utils.RoundCornerImageView
        android:id="@+id/selection_layer"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        app:corner_radius="18dp"
        android:src="@drawable/image_selected_layer"
        android:visibility="gone"
        android:elevation="3dp"
        />

    <com.example.mediahider.utils.RoundCornerImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        app:corner_radius="18dp"
        />

    <RelativeLayout
        android:id="@+id/rl_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@+id/image"
        >
        <TextView
            android:id="@+id/tv_folder_name"
            android:singleLine="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing8"
            android:layout_marginBottom="2dp"
            android:textColor="@color/black"
            />
        <TextView
            android:id="@+id/tv_folder_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing8"
            android:layout_marginBottom="2dp"
            android:layout_below="@+id/tv_folder_name"
            android:textColor="#6C6C6C"
            />
        <TextView
            android:id="@+id/tv_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginEnd="@dimen/spacing8"
            android:layout_marginBottom="2dp"
            android:layout_alignParentEnd="true"
            />

    </RelativeLayout>
    <ImageView
        android:id="@+id/img_selected"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:tint="@color/white"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_unselect"
        android:layout_marginStart="8dp"

        android:elevation="4dp"
        android:layout_marginTop="8dp"
        />

    <CheckBox
        android:id="@+id/itemCheckBox"
        android:layout_alignParentEnd="true"
        android:layout_width="wrap_content"
        android:theme="@style/CheckboxStyle"
        android:layout_height="wrap_content"
        />

</RelativeLayout>